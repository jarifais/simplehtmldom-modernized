{
    "name": "jarifais/simplehtmldom-modernized",
    "description": "Fork no oficial de Simple HTML DOM 1.9.1 con correcciones verificadas / Unofficial Simple HTML DOM 1.9.1 fork with verified fixes",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/jarifais/simplehtmldom-modernized",
    "keywords": [
        "html",
        "dom",
        "parser",
        "simple-html-dom",
        "php"
    ],
    "support": {
        "issues": "https://github.com/jarifais/simplehtmldom-modernized/issues",
        "source": "https://github.com/jarifais/simplehtmldom-modernized"
    },
    "require": {
        "php": ">=8.2",
        "ext-iconv": "*"
    },
    "suggest": {
        "ext-mbstring": "Optional charset detection for documents without declared encoding / Detección opcional de codificación"
    },
    "autoload": {
        "files": [
            "librerias/fase1/simple_html_dom.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": [
            "@php pruebas/ejecutar_todo.php",
            "phpunit"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
